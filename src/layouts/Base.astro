---
import type { Locale } from '../lib/content/constants.ts';
import { COPY, REPOSITORY_URL, SITE_STAGE } from '../lib/copy.ts';
import { OTHER_LOCALE, UI, pageUrl, sectionUrl, url } from '../lib/i18n.ts';
import { MODE, visibleTypes } from '../lib/site.ts';
import { DEMO_SLUG, DEMO_UI } from '../lib/demo.ts';
import { ATLAS_UI } from '../lib/atlas.ts';
import '../styles/base.css';

interface Props {
  locale: Locale;
  title: string;
  /** Path of the same page in the other language. */
  alternate: string;
  description?: string;
  banner?: 'draft' | 'fixture' | 'demo';
}
const { locale, title, alternate, description, banner } = Astro.props;
const t = UI[locale];
const other = OTHER_LOCALE[locale];
const here = Astro.url.pathname;
const pageTitle = title === t.siteTitle ? title : `${title} · ${t.siteTitle}`;
const nav = [
  { href: url(locale), label: t.home },
  { href: pageUrl(locale, 'methodology'), label: t.methodology },
  ...(await visibleTypes()).map((type) => ({ href: sectionUrl(locale, type), label: t.sections[type] })),
  // The atlas uses real (physical) geography; the demo is separately labelled as invented.
  { href: url(locale, 'atlas'), label: ATLAS_UI[locale].navLabel },
  { href: url(locale, 'demo', DEMO_SLUG[locale]), label: DEMO_UI[locale].navLabel },
];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="build-mode" content={MODE} />
    {MODE !== 'production' && <meta name="robots" content="noindex, nofollow" />}
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href={`${url()}favicon.svg`} type="image/svg+xml" />
    <link rel="alternate" hreflang={locale} href={new URL(here, Astro.site)} />
    <link rel="alternate" hreflang={other} href={new URL(alternate, Astro.site)} />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skipToContent}</a>
    <header class="site-header">
      <div class="header-row">
        <a class="site-title" href={url(locale)}>{t.siteTitle}</a>
        <a class="language-switch" href={alternate} hreflang={other} lang={other} data-language-switch>
          {t.switchLanguage}
        </a>
      </div>
      <nav aria-label={t.mainNav}>
        <ul>
          {nav.map((item) => (
            <li>
              <a href={item.href} aria-current={here === item.href ? 'page' : undefined}>{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </header>
    {SITE_STAGE === 'preview' && MODE === 'production' && (
      <p class="banner banner-preview" role="note"><strong>{t.previewLabel}.</strong> {COPY[locale].previewNotice}</p>
    )}
    {banner === 'draft' && <p class="banner banner-draft" role="note">{t.draftBanner}</p>}
    {banner === 'fixture' && <p class="banner banner-fixture" role="note">{t.fixtureBanner}</p>}
    {banner === 'demo' && <p class="banner banner-demo" role="note"><strong>{DEMO_UI[locale].navLabel}.</strong> {DEMO_UI[locale].banner}</p>}
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <nav aria-label={t.footerNav}>
        <ul>
          <li><a href={pageUrl(locale, 'methodology')}>{t.methodology}</a></li>
          <li><a href={REPOSITORY_URL} rel="noopener">{t.repository}</a></li>
          <li><a href={alternate} hreflang={other} lang={other} data-language-switch>{t.switchLanguage}</a></li>
        </ul>
      </nav>
      <p>{COPY[locale].footer}</p>
    </footer>
    <script>
      // Keep filter context (query string) and in-page position when switching language.
      for (const a of document.querySelectorAll<HTMLAnchorElement>('a[data-language-switch]')) {
        a.addEventListener('click', () => {
          const target = new URL(a.href);
          target.search = location.search;
          target.hash = location.hash;
          a.href = target.href;
        });
      }
    </script>
  </body>
</html>
