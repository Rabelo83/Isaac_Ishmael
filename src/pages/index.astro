---
// Bilingual landing page. No Accept-Language redirect: it works without JavaScript.
import '../styles/base.css';
import { COPY, REPOSITORY_URL, SITE_STAGE } from '../lib/copy.ts';
import { UI, url } from '../lib/i18n.ts';
import { MODE } from '../lib/site.ts';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="build-mode" content={MODE} />
    {MODE !== 'production' && <meta name="robots" content="noindex, nofollow" />}
    <title>{UI.en.siteTitle} · {UI.es.siteTitle}</title>
    <meta name="description" content={COPY.en.homeLead} />
    <link rel="icon" href={`${url()}favicon.svg`} type="image/svg+xml" />
    <link rel="alternate" hreflang="en" href={new URL(url('en'), Astro.site)} />
    <link rel="alternate" hreflang="es" href={new URL(url('es'), Astro.site)} />
  </head>
  <body>
    <main id="main" class="landing">
      <h1>{UI.en.siteTitle} <span aria-hidden="true">·</span> <span lang="es">{UI.es.siteTitle}</span></h1>
      {SITE_STAGE === 'preview' && (
        <p class="banner banner-preview" role="note">
          <strong>{UI.en.previewLabel}.</strong> {COPY.en.previewNotice}
          <span lang="es"><strong>{UI.es.previewLabel}.</strong> {COPY.es.previewNotice}</span>
        </p>
      )}
      <div class="landing-columns">
        <section lang="en" aria-labelledby="enter-en">
          <h2 id="enter-en">English</h2>
          <p>{COPY.en.homeLead}</p>
          <p><a class="button" href={url('en')} hreflang="en">Enter in English</a></p>
        </section>
        <section lang="es" aria-labelledby="enter-es">
          <h2 id="enter-es">Español</h2>
          <p>{COPY.es.homeLead}</p>
          <p><a class="button" href={url('es')} hreflang="es">Entrar en español</a></p>
        </section>
      </div>
      <p class="landing-repo">
        <a href={REPOSITORY_URL} rel="noopener">GitHub</a>
      </p>
    </main>
  </body>
</html>
