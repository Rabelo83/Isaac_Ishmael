---
// Bilingual landing page. No Accept-Language redirect: it works without JavaScript.
import '../styles/base.css';
import { UI, url } from '../lib/i18n.ts';
import { MODE } from '../lib/site.ts';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="build-mode" content={MODE} />
    {MODE !== 'production' && <meta name="robots" content="noindex, nofollow" />}
    <title>{UI.en.siteTitle} · {UI.es.siteTitle}</title>
    <link rel="alternate" hreflang="en" href={new URL(url('en'), Astro.site)} />
    <link rel="alternate" hreflang="es" href={new URL(url('es'), Astro.site)} />
  </head>
  <body>
    <main id="main">
      <h1>{UI.en.siteTitle} <span aria-hidden="true">·</span> <span lang="es">{UI.es.siteTitle}</span></h1>
      <p>{UI.en.siteTagline}</p>
      <p lang="es">{UI.es.siteTagline}</p>
      <nav aria-label="Language / Idioma">
        <ul>
          <li><a href={url('en')} hreflang="en">English</a></li>
          <li><a href={url('es')} hreflang="es" lang="es">Español</a></li>
        </ul>
      </nav>
    </main>
  </body>
</html>
