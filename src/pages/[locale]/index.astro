---
import Base from '../../layouts/Base.astro';
import { LOCALES, type Locale } from '../../lib/content/constants.ts';
import { COPY, REPOSITORY_URL } from '../../lib/copy.ts';
import { OTHER_LOCALE, UI, pageUrl, recordUrl, sectionUrl, url } from '../../lib/i18n.ts';
import { allRecords, titleFor } from '../../lib/site.ts';
import { DEMO_SLUG, DEMO_UI } from '../../lib/demo.ts';
import { ATLAS_UI } from '../../lib/atlas.ts';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}
const locale = Astro.params.locale as Locale;
const t = UI[locale];
const c = COPY[locale];
const d = DEMO_UI[locale];
const a = ATLAS_UI[locale];
// Published explanations only (never drafts, even in a preview build); sources are reached from each page.
const publishedRecords = (await allRecords()).filter((r) => r.review_status === 'published');
const publishedTypes = new Set(publishedRecords.map((r) => r.type));
const published = await Promise.all(
  publishedRecords
    .filter((r) => r.type !== 'source')
    .map(async (r) => ({ href: recordUrl(locale, r.type, r.id), title: await titleFor(locale, r.id) })),
);
---

<Base locale={locale} title={t.siteTitle} alternate={url(OTHER_LOCALE[locale])} description={c.homeLead}>
  <h1>{t.siteTitle}</h1>
  <p class="lead">{c.homeLead}</p>

  <section aria-labelledby="purpose">
    <h2 id="purpose">{c.purposeHeading}</h2>
    {c.purpose.map((p) => <p>{p}</p>)}
  </section>

  <section aria-labelledby="areas">
    <h2 id="areas">{c.areasHeading}</h2>
    <p>{c.areasIntro}</p>
    <ul class="areas">
      {c.areas.map((a) => (
        <li class="area">
          <h3>{a.title}</h3>
          <p>{a.body}</p>
          {a.section && publishedTypes.has(a.section)
            ? <p><a href={sectionUrl(locale, a.section)}>{c.openSection}</a></p>
            : <p class="status-tag">{c.forthcoming}</p>}
        </li>
      ))}
    </ul>
  </section>

  {published.length > 0 && (
    <section aria-labelledby="published">
      <h2 id="published">{c.publishedHeading}</h2>
      <p>{c.publishedIntro}</p>
      <ul>{published.map((p) => <li><a href={p.href}>{p.title}</a></li>)}</ul>
      <p><a href={sectionUrl(locale, 'source')}>{c.publishedSources}</a></p>
    </section>
  )}

  <section aria-labelledby="atlas" class="demo-callout">
    <h2 id="atlas">{a.homeHeading}</h2>
    <p>{a.homeBody}</p>
    <p><a class="button" href={url(locale, 'atlas')}>{a.homeLink}</a></p>
  </section>

  <section aria-labelledby="demo" class="demo-callout">
    <h2 id="demo">{d.homeHeading}</h2>
    <p>{d.homeBody}</p>
    <p><a class="button" href={url(locale, 'demo', DEMO_SLUG[locale])}>{d.homeLink}</a></p>
  </section>

  <section aria-labelledby="method">
    <h2 id="method">{c.methodHeading}</h2>
    <ul>{c.methodSummary.map((p) => <li>{p}</li>)}</ul>
    <p><a href={pageUrl(locale, 'methodology')}>{c.methodLink}</a></p>
  </section>

  <section aria-labelledby="not">
    <h2 id="not">{c.notHeading}</h2>
    <ul>{c.notList.map((p) => <li>{p}</li>)}</ul>
    <p>{c.trackingNote}</p>
  </section>

  <section aria-labelledby="repo">
    <h2 id="repo">{c.repoHeading}</h2>
    <p>{c.repoBody} <a href={REPOSITORY_URL} rel="noopener">{c.repoLink}</a></p>
  </section>
</Base>
